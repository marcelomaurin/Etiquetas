; Script generated by the Inno Setup Script Wizard.

#define MyAppName "Etiquetas"
#define MyAppVersion "0121"
#define MyAppPublisher "MAURINSOFT"
#define MyAppURL "http://maurinsoft.com.br"
#define MyAppExeName "etiquetas.exe"
#define MyInstallExeName "setup_etiquetas_0121"

[Setup]
AppId={{25A25926-C819-4F28-B173-8916AF42FCD4}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
VersionInfoVersion=1.21.0.0
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonpf}\{#MyAppName}
DisableProgramGroupPage=yes
OutputDir=..\..\bin\
OutputBaseFilename={#MyInstallExeName}
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Types]
Name: "ETIQUETA"; Description: {cm:T_ETIQUETA}

[Components]
Name: "Etiqueta"; Description: "Arquivos da Etiqueta"; Types: ETIQUETA;

[CustomMessages]
T_ETIQUETA=ETIQUETA
TD_ETIQUETA=Install demo ETIQUETA 

[Files]
; Fundos ilustrados do editor de QR Code
Source: "..\..\background\qrcode\*.png"; DestDir: "{app}\background\qrcode\"; Flags: ignoreversion
; Executável principal
Source: "..\..\src\etiquetas.exe"; DestDir: "{app}"; Flags: ignoreversion
; Copiando background para local
Source: "..\..\background\*.png"; DestDir: "{commonappdata}\Etiquetas\background\"; Flags: ignoreversion
; Cria o banco local padrão em C:\db\ se não existir (com permissão de escrita para usuários)
Source: "..\..\db\etiqueta.db"; DestDir: "C:\db\"; Flags: onlyifdoesntexist uninsneveruninstall; Permissions: users-modify
; Banco modelo na pasta da aplicação e dados globais
Source: "..\..\db\etiqueta.db"; DestDir: "{app}\db\"; Flags: ignoreversion
Source: "..\..\db\etiqueta.db"; DestDir: "{commonappdata}\Etiquetas\db\"; Flags: onlyifdoesntexist uninsneveruninstall
Source: "..\..\csv\*.csv"; DestDir: "{commonappdata}\Etiquetas\csv\"; Flags: ignoreversion


; Biblioteca SQLite na pasta da aplicação
Source: "..\..\src\libs\sqlite\win64\sqlite3.dll"; DestDir: "{app}\sqlite\win64\"; Flags: ignoreversion
Source: "..\..\src\libs\sqlite\win64\sqlite3.def"; DestDir: "{app}\sqlite\win64\"; Flags: ignoreversion
Source: "..\..\src\libs\sqlite\win32\sqlite3.dll"; DestDir: "{app}\sqlite\win32\"; Flags: ignoreversion
Source: "..\..\src\libs\sqlite\win32\sqlite3.def"; DestDir: "{app}\sqlite\win32\"; Flags: ignoreversion
Source: "..\..\src\libs\sqlite\win32\sqlite3.dll"; DestDir: "{app}\"; Flags: ignoreversion


[Dirs]
Name: "C:\db\"; Permissions: users-modify

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppExeName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
